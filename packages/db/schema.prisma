model TechnicianSchedule {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 company Company @relation(fields:[companyId],references:[id])
 technicianId String @db.Uuid
 serviceOrderId String? @db.Uuid
 title String
 startsAt DateTime
 endsAt DateTime
