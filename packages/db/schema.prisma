  APPROVE
  DECLINE
}
enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model CustomerPortalUser {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 customerId String @db.Uuid
 name String
 email String
 phone String?
 passwordHash String
 active Boolean @default(true)
 lastLoginAt DateTime?
 createdAt DateTime @default(now())
