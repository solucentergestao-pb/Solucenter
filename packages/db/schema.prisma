generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

enum CustomerType {
  PF
  PJ
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  REPLACEMENT_RECOMMENDED
  REMOVED
}
enum OrderStatus {
  DRAFT
  OPEN
  SCHEDULED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  WAITING_APPROVAL
  WAITING_PARTS
  COMPLETED
  INVOICED
  RECEIVED
  CANCELLED
}
enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  DECLINED
  EXPIRED
  CANCELLED
}
enum InventoryMovementType {
  PURCHASE
  SERVICE_USAGE
  RETURN
  ADJUSTMENT
  LOSS
}
enum PhotoCategory {
  BEFORE
  DURING
  AFTER
  NAMEPLATE
  DEFECT
  INSTALLATION
  OTHER
}
enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}
enum PayableStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}
enum PaymentMethod {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  BOLETO
  OTHER
}
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT
  STOCK_MOVEMENT
  QUOTE_SENT
  QUOTE_APPROVED
  QUOTE_CONVERTED
  RECEIVABLE_CREATED
}
enum NotificationChannel {
  IN_APP
  WHATSAPP
  EMAIL
}
enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}
enum NotificationEventType {
  QUOTE_SENT
  QUOTE_APPROVED
  MAINTENANCE_DUE
  APPOINTMENT_SCHEDULED
  TECHNICIAN_ON_THE_WAY
  SERVICE_ORDER_COMPLETED
  RECEIVABLE_CREATED
  PAYMENT_RECEIVED
  RECEIPT_ISSUED
}

model Company {
 id String @id @default(uuid()) @db.Uuid
 tradeName String
 legalName String?
 cnpj String? @unique
 phone String?
 whatsapp String?
 email String?
 logoUrl String?
 timezone String @default("America/Fortaleza")
 users User[]
 customers Customer[]
 equipment Equipment[]
 serviceOrders ServiceOrder[]
 quotes Quote[]
 materials Material[]
 receivables AccountReceivable[]
 payables AccountPayable[]
 auditLogs AuditLog[]
 technicianSchedules TechnicianSchedule[]
 portalUsers CustomerPortalUser[]
 portalRequests CustomerRequest[]
 suppliers Supplier[]
 purchaseOrders PurchaseOrder[]
 settings CompanySettings?
 notificationTemplates NotificationTemplate[]
 notifications Notification[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model Role {
 id String @id @default(uuid()) @db.Uuid
 companyId String? @db.Uuid
 name String
 description String?
 users User[]
 permissions RolePermission[]
 @@unique([companyId,name])
}
model Permission {
 id String @id @default(uuid()) @db.Uuid
 code String @unique
 description String?
 roles RolePermission[]
}
model RolePermission {
 roleId String @db.Uuid
 permissionId String @db.Uuid
 role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
 permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
 @@id([roleId,permissionId])
}
model User {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 roleId String @db.Uuid
 name String
 email String
 phone String?
 passwordHash String
 status UserStatus @default(ACTIVE)
 lastLoginAt DateTime?
 company Company @relation(fields:[companyId],references:[id])
 role Role @relation(fields:[roleId],references:[id])
 createdOrders ServiceOrder[] @relation("CreatedOrders")
 createdQuotes Quote[]
 assignedOrders ServiceOrderTechnician[]
 auditLogs AuditLog[]
 technicianSchedules TechnicianSchedule[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([companyId,email])
 @@index([companyId,status])
}
model Customer {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 code String
 type CustomerType
 name String
 legalName String?
 tradeName String?
 cpfCnpj String?
 stateRegistration String?
 phone String?
 whatsapp String?
 email String?
 notes String?
 active Boolean @default(true)
 company Company @relation(fields:[companyId],references:[id])
 contacts CustomerContact[]
 units CustomerUnit[]
 equipment Equipment[]
 serviceOrders ServiceOrder[]
 quotes Quote[]
 receivables AccountReceivable[]
 maintenancePlans MaintenancePlan[]
 portalUsers CustomerPortalUser[]
 portalRequests CustomerRequest[]
 quoteDecisions CustomerQuoteDecision[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([companyId,code])
 @@unique([companyId,cpfCnpj])
 @@index([companyId,name])
 @@index([companyId,active])
}
model CustomerContact {
 id String @id @default(uuid()) @db.Uuid
 customerId String @db.Uuid
 name String
 role String?
 phone String?
 whatsapp String?
 email String?
 primary Boolean @default(false)
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 @@index([customerId])
}
model CustomerUnit {
 id String @id @default(uuid()) @db.Uuid
 customerId String @db.Uuid
 name String
 cep String?
 street String?
 number String?
 complement String?
 neighborhood String?
 city String?
 state String?
 reference String?
 latitude Decimal? @db.Decimal(10,7)
 longitude Decimal? @db.Decimal(10,7)
 active Boolean @default(true)
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 environments Environment[]
 equipment Equipment[]
 serviceOrders ServiceOrder[]
 quotes Quote[]
 @@index([customerId,name])
}
model Environment {
 id String @id @default(uuid()) @db.Uuid
 unitId String @db.Uuid
 name String
 floor String?
 sector String?
 description String?
 unit CustomerUnit @relation(fields:[unitId],references:[id],onDelete:Cascade)
 equipment Equipment[]
 serviceOrders ServiceOrder[]
 @@unique([unitId,name])
 @@index([unitId])
}
model Manufacturer {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 models EquipmentModel[]
}
model EquipmentModel {
 id String @id @default(uuid()) @db.Uuid
 manufacturerId String @db.Uuid
 name String
 equipmentType String?
 manufacturer Manufacturer @relation(fields:[manufacturerId],references:[id])
 equipment Equipment[]
 manuals TechnicalManual[]
 @@unique([manufacturerId,name])
}
model Equipment {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 customerId String @db.Uuid
 unitId String @db.Uuid
 environmentId String? @db.Uuid
 modelId String? @db.Uuid
 assetCode String
 serialNumber String?
 equipmentType String
 capacityBtu Int?
 technology String?
 cycle String?
 voltage Int?
 phase String?
 refrigerant String?
 installationDate DateTime?
 warrantyUntil DateTime?
 status EquipmentStatus @default(ACTIVE)
 notes String?
 company Company @relation(fields:[companyId],references:[id])
 customer Customer @relation(fields:[customerId],references:[id])
 unit CustomerUnit @relation(fields:[unitId],references:[id])
 environment Environment? @relation(fields:[environmentId],references:[id])
 model EquipmentModel? @relation(fields:[modelId],references:[id])
 installation EquipmentInstallation?
 qr EquipmentQr?
 photos EquipmentPhoto[]
 history EquipmentHistory[]
 serviceOrders ServiceOrder[]
 maintenancePlans MaintenancePlanEquipment[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([companyId,assetCode])
 @@index([companyId,customerId])
 @@index([unitId,environmentId])
 @@index([serialNumber])
}
model EquipmentInstallation {
 id String @id @default(uuid()) @db.Uuid
 equipmentId String @unique @db.Uuid
 liquidPipe String?
 gasPipe String?
 pipeLengthM Decimal? @db.Decimal(8,2)
 heightDifferenceM Decimal? @db.Decimal(8,2)
 powerCable String?
 breakerRating String?
 drainType String?
 vacuumMicrons Int?
 tightnessTest Boolean?
 additionalRefrigerantG Int?
 notes String?
 equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Cascade)
}
model EquipmentQr {
 id String @id @default(uuid()) @db.Uuid
 equipmentId String @unique @db.Uuid
 token String @unique
 active Boolean @default(true)
 createdAt DateTime @default(now())
 revokedAt DateTime?
 equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Cascade)
}
model EquipmentPhoto {
 id String @id @default(uuid()) @db.Uuid
 equipmentId String @db.Uuid
 category PhotoCategory
 fileUrl String
 description String?
 createdAt DateTime @default(now())
 equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Cascade)
 @@index([equipmentId,category])
}
model EquipmentHistory {
 id String @id @default(uuid()) @db.Uuid
 equipmentId String @db.Uuid
 eventType String
 description String
 occurredAt DateTime @default(now())
 equipment Equipment @relation(fields:[equipmentId],references:[id],onDelete:Cascade)
 @@index([equipmentId,occurredAt])
}
model TechnicalManual {
 id String @id @default(uuid()) @db.Uuid
 modelId String? @db.Uuid
 title String
 version String?
 fileUrl String
 model EquipmentModel? @relation(fields:[modelId],references:[id])
 createdAt DateTime @default(now())
}

model ServiceType {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 name String
 basePrice Decimal @default(0) @db.Decimal(12,2)
 active Boolean @default(true)
 orders ServiceOrder[]
 @@unique([companyId,name])
}
model ServiceOrder {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 quoteId String? @db.Uuid
 quote Quote? @relation(fields:[quoteId],references:[id])
 orderNumber String
 customerId String @db.Uuid
 unitId String @db.Uuid
 environmentId String? @db.Uuid
 equipmentId String? @db.Uuid
 serviceTypeId String? @db.Uuid
 priority OrderPriority @default(NORMAL)
 status OrderStatus @default(OPEN)
 reportedProblem String
 technicalDiagnosis String?
 performedService String?
 recommendations String?
 scheduledAt DateTime?
 startedAt DateTime?
 completedAt DateTime?
 quotedValue Decimal? @db.Decimal(12,2)
 finalValue Decimal? @db.Decimal(12,2)
 laborCost Decimal @default(0) @db.Decimal(12,2)
 travelCost Decimal @default(0) @db.Decimal(12,2)
 feesCost Decimal @default(0) @db.Decimal(12,2)
 otherCost Decimal @default(0) @db.Decimal(12,2)
 createdById String @db.Uuid
 company Company @relation(fields:[companyId],references:[id])
 customer Customer @relation(fields:[customerId],references:[id])
 unit CustomerUnit @relation(fields:[unitId],references:[id])
 environment Environment? @relation(fields:[environmentId],references:[id])
 equipment Equipment? @relation(fields:[equipmentId],references:[id])
 serviceType ServiceType? @relation(fields:[serviceTypeId],references:[id])
 createdBy User @relation("CreatedOrders",fields:[createdById],references:[id])
 statusHistory ServiceOrderStatusHistory[]
 technicians ServiceOrderTechnician[]
 measurements ServiceMeasurement[]
 photos ServicePhoto[]
 materials ServiceOrderMaterial[]
 signatures ServiceOrderSignature[]
 checklistItems ServiceOrderChecklistItem[]
 technicianSchedules TechnicianSchedule[]
 maintenanceOccurrences MaintenanceOccurrence[]
 receivables AccountReceivable[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([companyId,orderNumber])
 @@index([companyId,status,scheduledAt])
 @@index([customerId])
 @@index([equipmentId])
}
model ServiceOrderStatusHistory {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 previousStatus OrderStatus?
 newStatus OrderStatus
 userId String @db.Uuid
 notes String?
 createdAt DateTime @default(now())
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 @@index([serviceOrderId,createdAt])
}
model ServiceOrderTechnician {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 userId String @db.Uuid
 role String?
 startedAt DateTime?
 finishedAt DateTime?
 laborCost Decimal @default(0) @db.Decimal(12,2)
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 user User @relation(fields:[userId],references:[id])
 @@unique([serviceOrderId,userId])
}
model ServiceMeasurement {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 voltage Decimal? @db.Decimal(8,2)
 current Decimal? @db.Decimal(8,2)
 returnTemperature Decimal? @db.Decimal(6,2)
 supplyTemperature Decimal? @db.Decimal(6,2)
 deltaT Decimal? @db.Decimal(6,2)
 lowPressure Decimal? @db.Decimal(8,2)
 highPressure Decimal? @db.Decimal(8,2)
 superheat Decimal? @db.Decimal(6,2)
 subcooling Decimal? @db.Decimal(6,2)
 ambientTemperature Decimal? @db.Decimal(6,2)
 measuredAt DateTime @default(now())
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 @@index([serviceOrderId,measuredAt])
}
model ServicePhoto {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 category PhotoCategory
 fileUrl String
 description String?
 createdAt DateTime @default(now())
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 @@index([serviceOrderId,category])
}
model ServiceOrderSignature {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 signerName String
 fileUrl String
 signedAt DateTime @default(now())
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
}
model ServiceOrderChecklistItem {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 label String
 checked Boolean @default(false)
 notes String?
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 @@index([serviceOrderId])
}

model Material {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 sku String
 description String
 category String?
 unit String
 averageCost Decimal @default(0) @db.Decimal(12,2)
 lastCost Decimal @default(0) @db.Decimal(12,2)
 salePrice Decimal @default(0) @db.Decimal(12,2)
 stockQuantity Decimal @default(0) @db.Decimal(12,3)
 minimumStock Decimal @default(0) @db.Decimal(12,3)
 active Boolean @default(true)
 company Company @relation(fields:[companyId],references:[id])
 orderMaterials ServiceOrderMaterial[]
 movements InventoryMovement[]
 purchaseItems PurchaseOrderItem[]
 @@unique([companyId,sku])
 @@index([companyId,description])
}
model ServiceOrderMaterial {
 id String @id @default(uuid()) @db.Uuid
 serviceOrderId String @db.Uuid
 materialId String @db.Uuid
 quantity Decimal @db.Decimal(12,3)
 unitCost Decimal @db.Decimal(12,2)
 unitPrice Decimal @default(0) @db.Decimal(12,2)
 serviceOrder ServiceOrder @relation(fields:[serviceOrderId],references:[id],onDelete:Cascade)
 material Material @relation(fields:[materialId],references:[id])
 @@index([serviceOrderId])
 @@index([materialId])
}
model InventoryMovement {
 id String @id @default(uuid()) @db.Uuid
 materialId String @db.Uuid
 movementType InventoryMovementType
 quantity Decimal @db.Decimal(12,3)
 unitCost Decimal? @db.Decimal(12,2)
 serviceOrderId String? @db.Uuid
 userId String? @db.Uuid
 notes String?
 createdAt DateTime @default(now())
 material Material @relation(fields:[materialId],references:[id])
 @@index([materialId,createdAt])
 @@index([serviceOrderId])
}

model Quote {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 quoteNumber String
 customerId String @db.Uuid
 unitId String? @db.Uuid
 status QuoteStatus @default(DRAFT)
 subtotal Decimal @default(0) @db.Decimal(12,2)
 discount Decimal @default(0) @db.Decimal(12,2)
 total Decimal @default(0) @db.Decimal(12,2)
 estimatedCost Decimal @default(0) @db.Decimal(12,2)
 estimatedProfit Decimal @default(0) @db.Decimal(12,2)
 estimatedMargin Decimal @default(0) @db.Decimal(7,2)
 validUntil DateTime?
 paymentTerms String?
 warrantyTerms String?
 notes String?
 sentAt DateTime?
 viewedAt DateTime?
 approvedAt DateTime?
 declinedAt DateTime?
 convertedAt DateTime?
 createdById String @db.Uuid
 company Company @relation(fields:[companyId],references:[id])
 customer Customer @relation(fields:[customerId],references:[id])
 unit CustomerUnit? @relation(fields:[unitId],references:[id])
 createdBy User @relation(fields:[createdById],references:[id])
 serviceOrders ServiceOrder[]
 receivables AccountReceivable[]
 items QuoteItem[]
 portalDecisions CustomerQuoteDecision[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([companyId,quoteNumber])
 @@index([companyId,status])
}
model QuoteItem {
 id String @id @default(uuid()) @db.Uuid
 quoteId String @db.Uuid
 itemType String
 serviceId String? @db.Uuid
 materialId String? @db.Uuid
 description String
 quantity Decimal @db.Decimal(12,3)
 unitPrice Decimal @db.Decimal(12,2)
 unitCost Decimal @db.Decimal(12,2)
 quote Quote @relation(fields:[quoteId],references:[id],onDelete:Cascade)
 @@index([quoteId])
}

model AccountReceivable {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 customerId String @db.Uuid
 serviceOrderId String? @db.Uuid
 quoteId String? @db.Uuid
 description String
 originalAmount Decimal @db.Decimal(12,2)
 openAmount Decimal @db.Decimal(12,2)
 dueDate DateTime
 status ReceivableStatus @default(OPEN)
 company Company @relation(fields:[companyId],references:[id])
 customer Customer @relation(fields:[customerId],references:[id])
 serviceOrder ServiceOrder? @relation(fields:[serviceOrderId],references:[id])
 quote Quote? @relation(fields:[quoteId],references:[id])
 payments Payment[]
 @@index([companyId,status,dueDate])
 @@index([customerId])
}
model Payment {
 id String @id @default(uuid()) @db.Uuid
 receivableId String @db.Uuid
 amount Decimal @db.Decimal(12,2)
 paymentMethod PaymentMethod
 paymentDate DateTime @default(now())
 transactionReference String?
 notes String?
 receivedById String? @db.Uuid
 receivable AccountReceivable @relation(fields:[receivableId],references:[id])
 @@index([receivableId,paymentDate])
}
model AccountPayable {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 description String
 amount Decimal @db.Decimal(12,2)
 dueDate DateTime
 paidDate DateTime?
 status PayableStatus @default(OPEN)
 paymentMethod PaymentMethod?
 company Company @relation(fields:[companyId],references:[id])
 @@index([companyId,status,dueDate])
}
model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 userId String? @db.Uuid
 action AuditAction
 entityType String
 entityId String?
 oldValues Json?
 newValues Json?
 ipAddress String?
 userAgent String?
 createdAt DateTime @default(now())
 company Company @relation(fields:[companyId],references:[id])
 user User? @relation(fields:[userId],references:[id])
 @@index([companyId,entityType,entityId])
 @@index([userId,createdAt])
}

enum ExpenseStatus {
  OPEN
  PAID
  CANCELLED
}
enum DocumentType {
  QUOTE
  SERVICE_ORDER
  TECHNICAL_REPORT
}

model ExpenseCategory {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 name String
 dreGroup String
