 status ExpenseStatus @default(OPEN)
 category ExpenseCategory @relation(fields:[categoryId],references:[id])
 @@index([companyId,competenceDate])
 @@index([companyId,status,dueDate])
 @@index([serviceOrderId])
}
model GeneratedDocument {
 id String @id @default(uuid()) @db.Uuid
 companyId String @db.Uuid
 type DocumentType
 entityId String @db.Uuid
 fileUrl String
 publicToken String @unique
 expiresAt DateTime?
 createdAt DateTime @default(now())
 @@index([companyId,type,entityId])
}

enum AppointmentStatus {
  SCHEDULED
  ASSIGNED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum MaintenanceFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}
enum MaintenanceOccurrenceStatus {
  PLANNED
  DUE
  SCHEDULED
  COMPLETED
  OVERDUE
  CANCELLED
}

model CompanySettings {
 id String @id @default(uuid()) @db.Uuid
 companyId String @unique @db.Uuid
 legalName String
 tradeName String
 cnpj String?
 phone String?
 whatsapp String?
 email String?
 website String?
 pixKey String?
 commercialTerms String?
 warrantyTerms String?
 quoteValidityDays Int @default(15)
